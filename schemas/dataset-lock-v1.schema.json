{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cvbench.dev/schemas/dataset-lock-v1.schema.json",
  "title": "CVBench dataset release lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "version", "install_path", "archive"],
  "properties": {
    "schema_version": {"const": "cvbench.dataset-lock/v1"},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "install_path": {
      "type": "string",
      "pattern": "^data/datasets/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "bytes", "sha256"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
